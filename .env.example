# OpenBuild local server settings. All optional. Copy to .env (or .env.local) and fill in;
# Bun loads both automatically. Never point OPENCHAT_CLOUD_URL at openchat's production deployment.

# Port to listen on (default 3100).
# PORT=
# Bind address (default 127.0.0.1). Set 0.0.0.0 only on a trusted network, with OPENCHAT_ALLOWED_HOSTS.
# HOST=
# All UI/API access requires a local password. Set it on the host with:
# bun bin/openbuild.ts password  (no cloud account; hash saved in the data directory)
# Plain HTTP does not encrypt passwords/cookies; prefer Tailscale HTTPS.
# Extra host names allowed to reach the API, comma-separated.
# OPENCHAT_ALLOWED_HOSTS=
# Where chats/settings are stored (default ~/Library/Application Support/OpenBuild on macOS).
# OPENCHAT_DATA_DIR=
# Set to "file" to keep API keys in a 0600 file instead of the OS keychain.
# OPENCHAT_SECRETS=
# Path of that file (default ~/.config/openbuild/secrets.json).
# OPENCHAT_SECRETS_FILE=
# Your OWN Convex dev deployment for sync, e.g. https://<your-dev-deployment>.convex.cloud. Empty = no sync.
# OPENCHAT_CLOUD_URL=
# The Pi executable (default: `pi` on PATH, else ~/.local/bin/pi).
# PI_BIN=
# Native Codex executable (default: `codex` on PATH or ~/.local/bin/codex).
# CODEX_BIN=
# Codex configuration/session directory (Codex default: ~/.codex).
# CODEX_HOME=
# Cursor Agent executable (default: cursor-agent, then agent on PATH or ~/.local/bin).
# CURSOR_BIN=

# Optional private whisper.cpp server base URLs (never browser-supplied).
# Enable in Settings → General → Local dictation, then select LAN or Tailscale.
# OPENBUILD_WHISPER_LAN_URL=http://127.0.0.1:8178
# OPENBUILD_WHISPER_TAILSCALE_URL=https://your-imac.your-tailnet.ts.net:8178
# For a userspace/custom-socket Tailscale daemon (used by openbuild start tailscale).
# OPENBUILD_TAILSCALE_SOCKET=
